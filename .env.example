# Supabase (public — safe to expose in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: enables real Claude slide generation. Without it the app uses
# its built-in deterministic content engine (which also produces charts).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
GENERATION_MODEL=
