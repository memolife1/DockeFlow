# Supabase (public — safe to expose in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to "true" only after the Google provider is enabled in the Supabase
# dashboard (Authentication > Providers > Google, with a Client ID/Secret
# from Google Cloud Console and the Supabase callback URL added there).
# That's a manual step separate from Supabase itself being configured —
# leave unset/"false" to keep the "Continue with Google" button hidden on
# login/signup rather than showing a button that fails on click.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Server-only: enables real Claude slide generation. Without it the app uses
# its built-in deterministic content engine (which also produces charts).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
GENERATION_MODEL=

# Server-only: enables real stock photos on image-zone layouts when a user
# picks "Stock photos" in the wizard. Without it, generation still succeeds
# but every image slide falls back to its solid theme-color placeholder —
# check server logs for "[Pexels] No API key configured" if photos aren't
# loading in production.
PEXELS_API_KEY=

# Stripe billing. Without these, usage limits aren't enforced (generation
# stays open) and the upgrade flow returns a clear "not configured" error
# instead of a broken checkout.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint, after adding
# https://<your-domain>/api/stripe/webhook — see README/deploy notes.
STRIPE_WEBHOOK_SECRET=
# Used to build the Stripe Checkout success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL=https://www.deckeflow.com

# NOT required by this app's billing code (see src/lib/subscription.ts —
# every user_subscriptions read/write is scoped to the caller's own JWT via
# SECURITY DEFINER Postgres functions). Only needed if you add server-side
# logic that must read/write *other* users' rows outside of Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=
