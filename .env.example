# Supabase (public — safe to expose in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: enables real Claude slide generation. Without it the app uses
# its built-in deterministic content engine (which also produces charts).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5
GENERATION_MODEL=

# Stripe billing. Without these, usage limits aren't enforced (generation
# stays open) and the upgrade flow returns a clear "not configured" error
# instead of a broken checkout.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint, after adding
# https://<your-domain>/api/stripe/webhook — see README/deploy notes.
STRIPE_WEBHOOK_SECRET=
# Used to build the Stripe Checkout success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL=https://www.deckeflow.com

# NOT required by this app's billing code (see src/lib/subscription.ts —
# every user_subscriptions read/write is scoped to the caller's own JWT via
# SECURITY DEFINER Postgres functions). Only needed if you add server-side
# logic that must read/write *other* users' rows outside of Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=
